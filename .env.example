# Copia este archivo como .env y rellena tus keys gratuitas
# Guiones con IA: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=qwen/qwen3.8-27b
# Fondos con video: https://www.pexels.com/api/
PEXELS_API_KEY=
# Voz Gemini: https://aistudio.google.com/ (Get API key)
GEMINI_API_KEY=
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_VOICE_ES=Kore
GEMINI_VOICE_EN=Puck
# Voz premium ElevenLabs (opcional, solo voz propia)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# TikTok (ver CONECTAR_TIKTOK.txt)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT=http://localhost:8081/callback
